FROM pspitzner/beets-flask@sha256:98b8b87281e0526f3b9ee517ed1a75da76ae77bfc16564999c5e72d413d1ec50 AS overlay-base

USER root
COPY --chown=beetle:beetle overlay/beets_flask_remediation /repo/backend/beets_flask_remediation
RUN sed -i 's/beets_flask\.server\.app:create_app/beets_flask_remediation:create_app/' /repo/entrypoint.sh \
    && grep -q 'beets_flask_remediation:create_app' /repo/entrypoint.sh

FROM overlay-base AS test
COPY --chown=beetle:beetle overlay/tests /repo/backend/tests_remediation
WORKDIR /repo/backend
RUN python tests_remediation/generate_fixtures.py \
    && python -m unittest discover -s tests_remediation -v \
    && python tests_remediation/smoke_app.py

FROM overlay-base AS runtime

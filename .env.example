# Base URLs can be local container URLs, LAN URLs, or tunnel URLs.
# API keys come from each app's Settings -> General page.

# Core media managers

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

RADARR_URL=http://radarr:7878
RADARR_API_KEY=

LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=

PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=

SABNZBD_URL=http://sabnzbd:8080
SABNZBD_API_KEY=

# Playback and library readers

JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USER=
NAVIDROME_PASS=

SUBWAVE_URL=http://subwave
SUBWAVE_ADMIN_USER=
SUBWAVE_ADMIN_PASS=

# Music import/download pipeline

BEETS_FLASK_URL=http://beets-flask:5001

# Optional read-only local music metadata/artwork audit.
# The container music mount must be positively verified read-only before a scan starts.
# MUSIC_AUDIT_ENABLED=true
# Artwork preview remains opt-in; enable only when the MCP endpoint is trusted/private.
# MUSIC_AUDIT_ARTWORK_PREVIEW_ENABLED=false
# MUSIC_AUDIT_ROOT=/music-library
# MUSIC_AUDIT_CACHE_DIR=/config/music-audit
# MUSIC_AUDIT_LOW_RESOLUTION_PX=600
# MUSIC_AUDIT_CONCURRENCY=4
# MUSIC_AUDIT_COOLDOWN_SECONDS=300
# MUSIC_AUDIT_MAX_FILES=100000
# MUSIC_AUDIT_MAX_IMAGE_BYTES=33554432

SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=

# Optional: enable write tools.
# Leave unset or false for read-only/search/preview mode.
# ALLOW_REQUESTS controls existing Sonarr/Radarr request writes.
# ALLOW_WRITE_NAVIDROME controls future Navidrome scan/write actions.
# ALLOW_WRITE_SUBWAVE controls future Subwave on-air/operator actions.
# ALLOW_REQUESTS=false
# ALLOW_WRITE_NAVIDROME=false
# ALLOW_WRITE_SUBWAVE=false

# Optional: MCP HTTP transport/browser settings

# Optional: comma-separated browser origins allowed to call Streamable HTTP.
# Leave unset for non-browser/local service clients.
# MEDIA_MCP_ALLOWED_ORIGINS=http://localhost:3000

# Optional: run as Streamable HTTP instead of stdio.
# MEDIA_MCP_TRANSPORT=http
# MEDIA_MCP_HTTP_PORT=3000

# Optional: comma-separated app names to disable even if configured.
# DISABLED_APPS=lidarr,prowlarr
